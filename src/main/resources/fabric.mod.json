{
    "schemaVersion": 1,
    "id": "mgshaders",
    "version": "${version}",
    "name": "MGShaders",
    "description": "Custom rendering pipeline for PowerVR-based devices via MobileGlues",
    "authors": ["denonexus"],
    "license": "LGPL-2.1-only",
    "icon": "assets/mgshaders/icon.png",
    "environment": "client",
    "entrypoints": {
        "main": ["com.denonexus.mgshaders.MGShaders"],
        "client": ["com.denonexus.mgshaders.client.MGShadersClient"]
    },
    "mixins": [
        {
            "config": "mgshaders.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~1.21.11",
        "java": ">=21",
        "fabric-api": "*"
    }
}
