{
    "schemaVersion": 1,
    "id": "mgshaders",
    "version": "${version}",
    "name": "MGShaders",
    "description": "Custom rendering pipeline for PowerVR-based devices via MobileGlues",
    "authors": ["denonexus"],
    "license": "LGPL-2.1-only",
    "icon": "assets/mgshaders/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.denonexus.mgshaders.MGShaders",
            "com.denonexus.mgshaders.region.RegionSystem"
        ],
        "client": [
            "com.denonexus.mgshaders.client.MGShadersClient",
            "com.denonexus.mgshaders.client.region.RegionSystemClient"
        ]
    },
    "mixins": [
        {
            "config": "mgshaders.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~1.21.11",
        "java": ">=21",
        "fabric-api": "*"
    }
}
